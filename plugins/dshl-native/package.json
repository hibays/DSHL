{
  "name": "@dshl/native",
  "version": "0.1.0",
  "description": "dshl native backend — a dsh plugin that loads the dshl-native napi-rs addon (.node DLL) and provides the full kernel capability set (window, tray, supervisor, terminal, OS actions) as the dshlNativeBackend Cordis service.",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "optionalDependencies": {
    "@dshl/native-win32-x64-msvc": "^0.1.0",
    "@dshl/native-win32-arm64-msvc": "^0.1.0",
    "@dshl/native-darwin-x64": "^0.1.0",
    "@dshl/native-darwin-arm64": "^0.1.0",
    "@dshl/native-linux-x64-gnu": "^0.1.0",
    "@dshl/native-linux-arm64-gnu": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "hibays",
  "homepage": "https://github.com/hibays/dsh-launcher/tree/main/plugins/dshl-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibays/dsh-launcher.git",
    "directory": "plugins/dshl-native"
  },
  "bugs": {
    "url": "https://github.com/hibays/dsh-launcher/issues"
  },
  "keywords": [
    "dsh",
    "dshl",
    "deepseek",
    "harness",
    "launcher",
    "native",
    "napi-rs",
    "addon",
    "cordis"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "build:release": "node scripts/build-native.mjs --release"
  }
}
